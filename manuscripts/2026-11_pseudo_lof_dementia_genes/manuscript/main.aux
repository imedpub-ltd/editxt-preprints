\newlabel{tab:clinvar_traps}{{2}{8}{Evidence-level audit of all 11 ClinVar Pathogenic / Likely Pathogenic predicted loss-of-function entries in \textit {PSEN1} and \textit {PSEN2}}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Evidence audit of ClinVar P/LP pLoF assertions and human--mouse junction conservation decay across conserved dementia gene exons. \textbf  {(A)} Re-classification of all 11 ClinVar P/LP pLoF records in \textit  {PSEN1} and \textit  {PSEN2} separating verified pseudo-LoF splice events ($\Delta \text  {E9}$, \texttt  {c.338+1del}), non-ADAD allelic disorders (Acne Inversa), and uncorroborated or skippable-exon PVS1 liabilities. \textbf  {(B)} Paired comparison across $n=29$ length-matched conserved coding exons comparing 60-bp exonic identity (mean 87.7\%, median 88.3\%) against adjacent 60-bp proximal intronic identity (mean 45.7\%, median 46.7\%) in human GRCh38 versus mouse GRCm39, illustrating \textit  {PSEN1} Exon 4 divergence (86.7\% exonic to 38.3\% intronic).}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:fig3}{{3}{8}{Evidence audit of ClinVar P/LP pLoF assertions and human--mouse junction conservation decay across conserved dementia gene exons. \textbf {(A)} Re-classification of all 11 ClinVar P/LP pLoF records in \textit {PSEN1} and \textit {PSEN2} separating verified pseudo-LoF splice events ($\Delta \text {E9}$, \texttt {c.338+1del}), non-ADAD allelic disorders (Acne Inversa), and uncorroborated or skippable-exon PVS1 liabilities. \textbf {(B)} Paired comparison across $n=29$ length-matched conserved coding exons comparing 60-bp exonic identity (mean 87.7\%, median 88.3\%) against adjacent 60-bp proximal intronic identity (mean 45.7\%, median 46.7\%) in human GRCh38 versus mouse GRCm39, illustrating \textit {PSEN1} Exon 4 divergence (86.7\% exonic to 38.3\% intronic)}{figure.3}{}}
